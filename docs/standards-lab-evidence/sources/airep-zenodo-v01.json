{"created": "2026-05-31T12:53:57.102749+00:00", "modified": "2026-05-31T12:53:57.316180+00:00", "id": 20475137, "conceptrecid": "20475136", "doi": "10.5281/zenodo.20475137", "conceptdoi": "10.5281/zenodo.20475136", "doi_url": "https://doi.org/10.5281/zenodo.20475137", "metadata": {"title": "AI Runtime Evidence Protocol (AIREP)", "doi": "10.5281/zenodo.20475137", "publication_date": "2026-05-31", "description": "<p>AIREP (AI Runtime Evidence Protocol) is a neutral, vendor- and model-independent record format in which one signed, hash-chained, canonical-JSON record corresponds to exactly one AI runtime governance decision &mdash; what was decided, on what basis, and, distinctively, what the supporting evidence does not cover (scope-honesty). Evidence is referenced by typed pointers; a SHA-256 hash chain binds each record to its position; a single reserved profiles member carries all vendor- or domain-specific content, kept out of the core by a mechanical neutrality test. This release includes the normative specification, a JSON Schema (Draft 2020-12), five binding profiles, and a conformance kit with two independent verifiers (Python and Node) that agree byte-for-byte, plus worked examples with reproducible Ed25519 signatures.<br><br>Status: Experimental &mdash; a proposed open format with one reference implementation (the Phionyx Reasoned Governance Envelope, which matures by conforming toward the format). It is not a ratified standard, a certification scheme, or a validated detection method.<br>&nbsp;&nbsp;</p>", "access_right": "open", "creators": [{"name": "Abak, Ali Toygar", "affiliation": null, "orcid": "0009-0002-3718-4010"}], "keywords": ["ai-governance", "runtime evidence", "interchange-format", "ai-accountability", "JSON schema", "hash chain", "audit", "RFC 8785"], "version": "0.1", "language": "eng", "custom": {"code:codeRepository": "https://github.com/halvrenofviryel/ai-runtime-evidence-protocol", "code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}, {"id": "javascript", "title": {"en": "JavaScript"}}], "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": false, "parent": {"pid_type": "recid", "pid_value": "20475136"}}]}}, "title": "AI Runtime Evidence Protocol (AIREP)", "links": {"self": "https://zenodo.org/api/records/20475137", "self_html": "https://zenodo.org/records/20475137", "preview_html": "https://zenodo.org/records/20475137?preview=1", "doi": "https://doi.org/10.5281/zenodo.20475137", "self_doi": "https://doi.org/10.5281/zenodo.20475137", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20475137", "reserve_doi": "https://zenodo.org/api/records/20475137/draft/pids/doi", "parent": "https://zenodo.org/api/records/20475136", "parent_html": "https://zenodo.org/records/20475136", "parent_doi": "https://doi.org/10.5281/zenodo.20475136", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20475136", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:20475137/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:20475137/sequence/default", "files": "https://zenodo.org/api/records/20475137/files", "media_files": "https://zenodo.org/api/records/20475137/media-files", "latest": "https://zenodo.org/api/records/20475137/versions/latest", "latest_html": "https://zenodo.org/records/20475137/latest", "versions": "https://zenodo.org/api/records/20475137/versions", "draft": "https://zenodo.org/api/records/20475137/draft", "access_links": "https://zenodo.org/api/records/20475137/access/links", "access_grants": "https://zenodo.org/api/records/20475137/access/grants", "access_users": "https://zenodo.org/api/records/20475137/access/users", "access_request": "https://zenodo.org/api/records/20475137/access/request", "access": "https://zenodo.org/api/records/20475137/access", "communities": "https://zenodo.org/api/recor