+
+def encode(value):
+    return (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
+
+
+def write(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(encode(value))
+
+
+def load(raw):
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise Invalid('duplicate JSON member: ' + key)
+            result[key] = value
+        return result
+    return json.loads(raw, object_pairs_hook=unique,
+                      parse_constant=lambda x: (_ for _ in ()).throw(Invalid('non-finite JSON: ' + x)))
+
+
+def inventory(root):
+    return {str(p.relative_to(root)): sha(p.read_bytes()) for p in sorted(root.rglob('*'))
+            if p.is_file() and '__pycache__' not in p.parts}
+
+
+class Recorder:
+    def __init__(self, out):
+        self.out, self.commands = out, []
+
+    def command(self, name, argv, cwd, stdin=None, timeout=180):
+        log = self.out / 'logs' / f'{len(self.commands)+1:02d}-{name}'
+        log.parent.mkdir(parents=True, exist_ok=True)
+        entry = {'name': name, 'argv': [str(x) for x in argv], 'cwd': str(cwd),
+                 'started_at_utc': datetime.now(timezone.utc).isoformat()}
+        try:
+            p = subprocess.run(entry['argv'], cwd=cwd, input=stdin, capture_output=True,
+                               env=ENV, timeout=timeout)
+            code, stdout, stderr = p.returncode, p.stdout, p.stderr
+        except subprocess.TimeoutExpired as exc:
+            code, stdout, stderr = -1, exc.stdout or b'', (exc.stderr or b'') + b'\nTIMEOUT\n'
+        except OSError as exc:
+            code, stdout, stderr = -1, b'', str(exc).encode()
+        for stream, raw in [('stdout', stdout), ('stderr', stderr)]:
+            path = log.with_suffix('.' + stream)
+            path.write_bytes(raw)
+            entry[stream] = {'path': str(path.relative_to(self.out)), 'sha256': sha(raw)}
+        if stdin is not None:
+            path = log.with_suffix('.stdin.json')
+            path.write_bytes(stdin)
+            entry['stdin'] = {'path': str(path.relative_to(self.out)), 'sha256': sha(stdin)}
+        entry['exit_code'] = code
+        self.commands.append(entry)
+        return code, stdout, stderr
+
+    def checked(self, name, argv, cwd):
+        code, stdout, stderr = self.command(name, argv, cwd)
+        if code:
+            raise Invalid(f'{name}: process failed (exit {code}); complete logs retained')
+        return stdout
+
+
+def source_root(repo, rec):
+    commit = rec.checked('resolve-release', ['git', 'rev-parse', TARGET['release']+'^{commit}'], repo).decode().strip()
+    if commit != TARGET['commit']:
+        raise Invalid('RELEASE_COMMIT_MISMATCH')
+    archive = rec.checked('archive-release', ['git', 'archive', '--format=tar', TARGET['commit']], repo)
+    # The tar is binary evidence: hash it, but avoid storing a redundant 17 MB log.
+    entry = rec.commands[-1]
+    (rec.out / entry['stdout']['path']).unlink()
+    entry['stdout']['path'] = None
+    entry['stdout']['retention'] = 'regenerate from exact git commit; SHA-256 retained'
+    if sha(archive) != PINS['release_archive_sha256']:
+        raise Invalid('RELEASE_ARCHIVE_BYTE_MISMATCH')
+    work = Path(tempfile.mkdtemp(prefix='airep-k2-release-'))
+    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
+        tar.extractall(work, filter='data')
+    for path, expected in PINS['release_files'].items():
+        if sha((work / path).read_bytes()) != expected:
+            raise Invalid('PINNED_SOURCE_MISMATCH: ' + path)
+    return work
+
+
+def bootstrap(work, rec):
+    base = 'spec/airep/v0.2/class-verification/'
+    rec.checked('python-version', ['python3', '-VV'], work)
+    rec.checked('node-version', ['node', '--version'], work)
+    rec.checked('offline-python', ['python3', base+'offline-python-deps/prepare_offline_venv.py',
+                                  '--venv', str(work / '.venv')], work)
+    rec.checked('offline-node', ['python3', base+'offline-node-deps/materialize_node_modules.py'], work)
+    return work / '.venv/bin/python'
+
+
+def seal_bundle(bundle, identity):
+    files = {}
+    for name in REQUIRED:
+        p = bundle / name
+        if not p.is_file() or p.is_symlink():
+            raise Invalid('BUNDLE_FILE_MISSING_OR_SYMLINK: ' + name)
+        files[name] = sha(p.read_bytes())
+    manifest = {'target': TARGET, 'implementation_id': identity, 'files': files,
+                'profile_basis': None, 'authorship': 'UNASSESSED'}
+    write(bundle / 'bundle.json', manifest)
+    return manifest
+
+
+def check_bundle(bundle):
+    if bundle.is_symlink():
+        raise Invalid('BUNDLE_DIRECTORY_SYMLINK')
+    if (bundle / 'bundle.json').is_symlink():
+        raise Invalid('BUNDLE_MANIFEST_SYMLINK')
+    manifest = load((bundle / 'bundle.json').read_bytes())
+    if not isinstance(manifest, dict):
+        raise Invalid('BUNDLE_MANIFEST_MUST_BE_OBJECT')
+    if manifest.get('target') != TARGET:
+        raise Invalid('TARGET_MISMATCH')
+    if (not isinstance(manifest.get('files'), dict) or set(manifest['files']) != set(REQUIRED)
+            or manifest.get('profile_basis') is not None):
+        raise Invalid('BUNDLE_FILE_SET_OR_PROFILE_BASIS_MISMATCH')
+    for name, expected in manifest['files'].items():
+        p = bundle / name
+        if p.is_symlink() or not p.is_file() or sha(p.read_bytes()) != expected:
+            raise Invalid('BUNDLE_BYTE_HASH_MISMATCH: ' + name)
+    docs = load((bundle / 'lifecycle.json').read_bytes())
+    if not isinstance(docs, list) or len(docs) != 5:
+        raise Invalid('MINIMAL_LIFECYCLE_REQUIRES_FIVE_ARTIFACTS')
+    if not all(isinstance(d, dict) for d in docs):
+        raise Invalid('ARTIFACT_MUST_BE_OBJECT')
+    wanted = Counter({'decision': 1, 'control': 2, 'execution': 1, 'effect': 1})
+    if Counter(d.get('artifact_type') for d in docs) != wanted:
+        raise Invalid('MINIMAL_LIFECYCLE_FAMILY_MISMATCH')
+    for d in docs:
+        if d.get('airep_version') != TARGET['wire_version']:
+            raise Invalid('WIRE_VERSION_MISMATCH')
+        if d.get('profiles'):
+            raise Invalid('PROFILE_BASIS_NOT_SUPPORTED_IN_MINIMAL_TRANSPORT')
+    controls = {(d.get('boundary_side'), d.get('control_event')) for d in docs if d['artifact_type'] == 'control'}
+    if controls != {('issuer', 'dispatched'), ('receiver', 'received')}:
+        raise Invalid('CONTROL_ROLE_SEPARATION_MISMATCH')
+    return manifest
+
+
+def consume(work, py, bundle, out, rec, input_name='lifecycle.json', policy=True):
+    out.mkdir(parents=True, exist_ok=False)
+    before = inventory(bundle)
+    common = ['--input', str(bundle / input_name), '--bindings', str(bundle / 'bindings.json'),
+              '--revocation', str(bundle / 'revocation.json')]
+    if policy:
+        common += ['--independence-policy', str(bundle / 'independence.json')]
+    rows = {}
+    for operation in ('verify', 'reconcile'):
+        path = out / (operation + '.json')
+        code, _, _ = rec.command(operation, [py, '-m', 'tools.airep_v02', operation, *common, '--out', path], work)
+        rows[operation] = {'exit_code': code, 'result': load(path.read_bytes()) if path.exists() else None}
+    if before != inventory(bundle):
+        raise Invalid('INPUT_BYTES_CHANGED_DURING_REFERENCE_CONSUMPTION')
+    rows['transport_status'] = 'EVALUATED' if all(r['exit_code'] == 0 for r in rows.values()) else 'PROCESS_ERROR'
+    rows['observation'] = projection(rows)
+    write(out / 'reference-result.json', rows)
+    return rows
+
+
+def projection(rows):
+    if rows.get('transport_status') != 'EVALUATED':
+        return None
+    v, r = rows['verify']['result'], rows['reconcile']['result']
+    return {'records': sorted([{'record_id': a['artifact_ref']['record_id'], 'class': a['class'],
+                               'authenticated_failures': a['authenticated_failures'],
+                               'authenticated_withheld': a['authenticated_withheld'],
+                               'witnessed_withheld': a['witnessed_withheld'],
+                               'observer_assessment': a['observer_assessment']}
+                              for a in v['verdicts']], key=lambda a: a['record_id']),
+            'reconciliation_summary': r['summary'],
+            'checks': sorted([{'check': c['check'], 'subject': c['subject'], 'state': c['state']}
+                              for c in r['checks']], key=lambda c: encode(c))}
+
+
+def node_parity(work, bundle, reference, out, rec):
+    out.mkdir()
+    rows = []
+    for request in sorted((bundle/'requests').glob('*.json')):
+        code, stdout, _ = rec.command('node-verify-'+request.stem,
+            ['node', 'tools/airep_v02/verify_node.mjs', '--request', request,
+             '--bindings', bundle/'bindings.json', '--revocation', bundle/'revocation.json',
+             '--independence-policy', bundle/'independence.json'], work)
+        result = load(stdout) if code == 0 else None
+        rows.append({'record_id': request.stem, 'exit_code': code, 'result': result})
+    expected = (reference.get('verify', {}).get('result') or {}).get('verdicts', [])
+    by_id = {r['artifact_ref']['record_id']: r for r in expected}
+    agrees = len(rows) == 5 and all(r['exit_code'] == 0 and r['result'] == by_id.get(r['record_id']) for r in rows)
+    write(out/'node-results.json', {'same_first_party_reference_family': True, 'agrees': agrees, 'records': rows})
+    return {'agrees': agrees, 'same_first_party_reference_family': True, 'results': rows}
+
+
+def validate_projection(value):
+    """Fail closed on malformed optional projections before marking them REPORTED."""
+    def require(condition):
+        if not condition:
+            raise Invalid('MALFORMED_COMPARISON_PROJECTION')
+
+    def obj(value, keys):
+        return isinstance(value, dict) and set(value) == set(keys)
+
+    def text(value):
+        return isinstance(value, str) and bool(value) and not any(0xd800 <= ord(c) <= 0xdfff for c in value)
+
+    def choice(value, choices):
+        return isinstance(value, str) and value in choices
+
+    def uint(value):
+        return type(value) is int and value >= 0
+
+    def reference(value):
+        return obj(value, ('record_id', 'chain_id')) and all(text(v) for v in value.values())
+
+    require(obj(value, ('records', 'reconciliation_summary', 'checks')))
+    records, summary, checks = value['records'], value['reconciliation_summary'], value['checks']
+    require(isinstance(records, list) and isinstance(checks, list))
+    identities = []
+    for record in records:
+        require(obj(record, ('record_id', 'class', 'observer_assessment', *PROJECTION_REASONS)))
+        require(text(record['record_id']))
+        identities.append(record['record_id'])
+        require(choice(record['class'], {'AIREP-Core', 'AIREP-Authenticated', 'AIREP-Witnessed'}))
+        require(choice(record['observer_assessment'], {'same_executor', 'independent', 'unknown', 'not_applicable'}))
+        for channel, reasons in PROJECTION_REASONS.items():
+            array = record[channel]
+            require(isinstance(array, list) and all(choice(reason, reasons) for reason in array))
+            require(array == sorted(set(array)))
+        if record['authenticated_failures'] or record['authenticated_withheld']:
+            require(record['class'] == 'AIREP-Core')
+        if record['witnessed_withheld']:
+            require(record['class'] != 'AIREP-Witnessed')
+    require(identities == sorted(set(identities)))
+    require(obj(summary, ('status', 'counts')) and obj(summary['counts'], STATES))
+    require(choice(summary['status'], {'FAILURE', 'INCOMPLETE', 'SATISFIED'}))
+    require(all(uint(n) for n in summary['counts'].values()))
+    for check in checks:
+        require(obj(check, ('check', 'subject', 'state')))
+        require(choice(check['check'], PROJECTION_SUBJECTS) and choice(check['state'], STATES))
+        subject, kind = check['subject'], PROJECTION_SUBJECTS[check['check']]
+        if kind == 'reference':
+            require(reference(subject))
+        elif kind == 'identity':
+            require(obj(subject, ('record_id',)) and text(subject['record_id']))
+        elif kind == 'instruction':
+            require(obj(subject, ('decision_ref', 'instruction_id'))
+                    and reference(subject['decision_ref']) and text(subject['instruction_id']))
+        elif kind == 'position':
+            require(obj(subject, ('chain_id', 'sequence')) and text(subject['chain_id'])
+                    and uint(subject['sequence']) and subject['sequence'] <= 9007199254740991)
+        elif kind == 'admission':
+            require(reference(subject) or (obj(subject, ('input_index',)) and uint(subject['input_index'])))
+        else:
+            require(obj(subject, ()))
+    require(checks == sorted(checks, key=encode))
+    counts = {state: sum(c['state'] == state for c in checks) for state in STATES}
+    require(summary['counts'] == counts)
+    status = ('FAILURE' if counts['FAILURE'] else 'INCOMPLETE'
+              if any(counts[s] for s in ('MISSING', 'NOT_EVALUATED', 'INDETERMINATE')) else 'SATISFIED')
+    require(summary['status'] == status)
+
+
+def adapter(config_path, role, bundle, out, rec):
+    if config_path is None:
+        return {'status': 'EXTERNAL_RESULT_NOT_SUPPLIED', 'independence': 'NOT_ASSESSED'}
+    out.mkdir(parents=True, exist_ok=False)
+    result = {'status': 'ADAPTER_ERROR', 'independence': 'NOT_ASSESSED'}
+    try:
+        config = load(config_path.read_bytes())
+        if not isinstance(config, dict):
+            raise Invalid('ADAPTER_CONFIG_MUST_BE_OBJECT')
+        if config.get('role') != role or config.get('target') != TARGET:
+            raise Invalid('ADAPTER_ROLE_OR_TARGET_MISMATCH')
+        if (not isinstance(config.get('implementation_id'), str) or not config['implementation_id']
+                or config['implementation_id'].startswith('reference:')):
+            raise Invalid('ADAPTER_IMPLEMENTATION_ID_REQUIRED')
+        argv = config.get('argv')
+        if not isinstance(argv, list) or not argv or not all(isinstance(a, str) and a for a in argv):
+            raise Invalid('ADAPTER_ARGV_REQUIRED')
+        source = Path(config['source_file']).resolve()
+        if not source.is_file() or sha(source.read_bytes()) != config['source_sha256']:
+            raise Invalid('ADAPTER_SOURCE_HASH_MISMATCH')
+        # Source closure/toolchain/licence remain the contributor's responsibility.
+        write(out / 'adapter-config.json', config)
+        before = inventory(bundle) if bundle is not None else None
+        request = {'adapter_contract': 'airep-k2-local-1', 'role': role, 'target': TARGET,
+                   'output_dir': str(out), 'input_bundle': str(bundle) if bundle else None,
+                   'input_manifest_sha256': sha((bundle / 'bundle.json').read_bytes()) if bundle else None}
+        if bundle is not None:
+            check_bundle(bundle)
+        code, stdout, _ = rec.command('adapter-'+role, argv, config_path.parent, encode(request))
+        result.update({'implementation_id': config['implementation_id'], 'exit_code': code,
+                       'source_sha256': config['source_sha256']})
+        if before is not None and before != inventory(bundle):
+            raise Invalid('INPUT_BYTES_CHANGED_DURING_ADAPTER')
+        if code:
+            result['status'] = 'ADAPTER_UNAVAILABLE' if code == -1 else 'ADAPTER_PROCESS_ERROR'
+            return result
+        response = load(stdout)
+        if not isinstance(response, dict):
+            raise Invalid('ADAPTER_RESPONSE_MUST_BE_OBJECT')
+        if response.get('role') != role or response.get('target') != TARGET:
+            raise Invalid('ADAPTER_RESPONSE_ROLE_OR_TARGET_MISMATCH')
+        if response.get('implementation_id') != config['implementation_id']:
+            raise Invalid('ADAPTER_IDENTITY_MISMATCH')
+        # Preserve the exact adapter bytes, including malformed projections whose
+        # strings cannot be re-encoded as admitted UTF-8 scalar text.
+        (out / 'response.json').write_bytes(stdout)
+        if role == 'producer':
+            produced = out / 'bundle'
+            manifest = check_bundle(produced)
+            if manifest.get('implementation_id') != config['implementation_id']:
+                raise Invalid('PRODUCER_BUNDLE_IDENTITY_MISMATCH')
+            result.update({'status': 'BUNDLE_SUPPLIED', 'bundle': str(produced), 'manifest': manifest})
+        else:
+            if response.get('input_manifest_sha256') != request['input_manifest_sha256']:
+                raise Invalid('CONSUMER_INPUT_HASH_MISMATCH')
+            if 'native_result' not in response:
+                raise Invalid('NATIVE_RESULT_REQUIRED')
+            # Comparison projection is optional; no native verifier format is prescribed.
+            observation = response.get('observation')
+            if observation is not None:
+                validate_projection(observation)
+            result.update({'status': 'REPORTED', 'observation': observation,
+                           'native_result': response['native_result']})
+    except (Invalid, ValueError, TypeError, KeyError, OSError) as exc:
+        result['error'] = str(exc)
+    return result
+
+
+def compare(reference, external):
+    if external['status'] != 'REPORTED':
+        return external['status']
+    if reference['transport_status'] != 'EVALUATED':
+        return 'REFERENCE_PROCESS_ERROR'
+    if external.get('observation') is None:
+        return 'NOT_COMPARABLE'
+    return 'PROJECTION_AGREES' if reference['observation'] == external['observation'] else 'PROJECTION_DIVERGES'
+
+
+def negatives(work, py, bundle, out, rec):
+    out.mkdir()
+    checks = []
+    docs = load((bundle / 'lifecycle.json').read_bytes())
+    for name, mutate, expected in (
+        ('byte-tamper', lambda b: (b/'lifecycle.json').write_bytes((b/'lifecycle.json').read_bytes()+b' '), 'BUNDLE_BYTE_HASH_MISMATCH'),
+        ('manifest-target', lambda b: write(b/'bundle.json', dict(load((b/'bundle.json').read_bytes()), target={})), 'TARGET_MISMATCH'),
+        ('wire-version', None, 'WIRE_VERSION_MISMATCH'),
+        ('control-role', None, 'CONTROL_ROLE_SEPARATION_MISMATCH'),
+    ):
+        b = out/name
+        shutil.copytree(bundle, b)
+        if mutate:
+            mutate(b)
+        else:
+            edited = deepcopy(docs)
+            if name == 'wire-version':
+                edited[0]['airep_version'] = '0.1'
+            else:
+                next(d for d in edited if d.get('boundary_side') == 'receiver')['boundary_side'] = 'issuer'
+            write(b/'lifecycle.json', edited)
+            seal_bundle(b, 'local-negative-test')
+        try:
+            check_bundle(b)
+            actual = 'ACCEPTED'
+        except Invalid as exc:
+            actual = str(exc)
+        checks.append({'name': name, 'expected': expected, 'actual': actual, 'assertion_met': actual.startswith(expected)})
+    for name in ('broken-decision', 'toctou-mismatch', 'no-receipt'):
+        result = consume(work, py, bundle, out/(name+'-result'), rec, 'variants/'+name+'.json')
+        summary = result['reconcile']['result']['summary'] if result['reconcile']['result'] else None
+        if name == 'broken-decision':
+            met = result['verify']['exit_code'] != 0 and summary is not None and summary['counts']['FAILURE'] > 0
+        elif name == 'toctou-mismatch':
+            met = result['transport_status'] == 'EVALUATED' and any(c['check'] == 'toctou' and c['state'] == 'FAILURE' for c in result['reconcile']['result']['checks'])
+        else:
+            met = result['transport_status'] == 'EVALUATED' and any(c['check'] == 'receiver_receipt' and c['state'] == 'MISSING' for c in result['reconcile']['result']['checks'])
+        checks.append({'name': name, 'assertion_met': met, 'verify_exit': result['verify']['exit_code'],
+                       'reconcile_exit': result['reconcile']['exit_code'], 'summary': summary})
+    result = consume(work, py, bundle, out/'no-independence-policy', rec, policy=False)
+    effect = next(v for v in result['verify']['result']['verdicts'] if v['artifact_ref']['record_id'] == 'demo.effect')
+    checks.append({'name': 'no-independence-policy', 'assertion_met': effect['observer_assessment'] == 'unknown',
+                   'observer_assessment': effect['observer_assessment']})
+    write(out/'negative-results.json', checks)
+    return checks
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('mode', choices=('produce', 'run'))
+    ap.add_argument('--repo', type=Path, default=Path.cwd())
+    ap.add_argument('--out', type=Path, required=True)
+    ap.add_argument('--local-bundle', type=Path)
+    ap.add_argument('--producer-adapter', type=Path)
+    ap.add_argument('--consumer-adapter', type=Path)
+    args = ap.parse_args(argv)
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    rec = Recorder(out)
+    record = {'target': TARGET, 'started_at_utc': datetime.now(timezone.utc).isoformat(),
+              'claim_boundary': 'LOCAL_REFERENCE_ONLY; third-party independence is not established',
+              'platform': platform.platform(), 'external_result': 'EXTERNAL_RESULT_NOT_SUPPLIED',
+              'harness_sources': {str(p.relative_to(HERE)): sha(p.read_bytes())
+                  for p in sorted(HERE.rglob('*')) if p.is_file()
+                  and 'evidence' not in p.relative_to(HERE).parts and '__pycache__' not in p.parts},
+              'commands': rec.commands}
+    work = None
+    try:
+        record['repository'] = {'path': str(args.repo.resolve()),
+            'head': rec.checked('head', ['git','rev-parse','HEAD'], args.repo).decode().strip(),
+            'status_before': rec.checked('status', ['git','status','--porcelain=v1'], args.repo).decode()}
+        work = source_root(args.repo, rec)
+        record['release_workdir'] = str(work)
+        record['release_archive_sha256'] = PINS['release_archive_sha256']
+        py = bootstrap(work, rec)
+        bundle = out/'local-reference-bundle'
+        if args.local_bundle:
+            check_bundle(args.local_bundle)
+            shutil.copytree(args.local_bundle, bundle)
+        else:
+            rec.checked('reference-producer', [py, 'examples/v02/run_lifecycle.py', '--out', bundle], work)
+            seal_bundle(bundle, 'reference:airep-v0.2.0-beta.1-python')
+        check_bundle(bundle)
+        record['local_bundle'] = {'path': str(bundle.relative_to(out)), 'files': inventory(bundle)}
+        if args.mode == 'produce':
+            record['status'] = 'LOCAL_REFERENCE_BUNDLE_WRITTEN'
+        else:
+            local = consume(work, py, bundle, out/'reference-to-reference', rec)
+            record['reference_to_reference'] = local
+            observation = local['observation']
+            record['reference_expectation_met'] = bool(observation and len(observation['records']) == 5
+                and all(v['class'] == 'AIREP-Authenticated' and not v['authenticated_failures']
+                        and not v['authenticated_withheld'] for v in observation['records'])
+                and observation['reconciliation_summary'] == {'status': 'INCOMPLETE', 'counts': {
+                    'SATISFIED': 37, 'FAILURE': 0, 'MISSING': 0, 'NOT_EVALUATED': 1, 'INDETERMINATE': 0}})
+            record['node_reference_parity'] = node_parity(work, bundle, local, out/'node-reference', rec)
+            record['negative_controls'] = negatives(work, py, bundle, out/'negative-controls', rec)
+            ep = adapter(args.producer_adapter.resolve() if args.producer_adapter else None,
+                         'producer', None, out/'external-producer', rec)
+            ec = adapter(args.consumer_adapter.resolve() if args.consumer_adapter else None,
+                         'consumer', bundle, out/'external-consumer-local-input', rec)
+            lanes = {'external_to_reference': {'producer': ep},
+                     'reference_to_external': {'consumer': ec, 'comparison': compare(local, ec)},
+                     'external_to_external': {'status': 'EXTERNAL_RESULT_NOT_SUPPLIED'}}
+            if ep['status'] == 'BUNDLE_SUPPLIED':
+                external_bundle = Path(ep['bundle'])
+                er = consume(work, py, external_bundle, out/'external-to-reference', rec)
+                lanes['external_to_reference']['reference_result'] = er
+                ee = adapter(args.consumer_adapter.resolve() if args.consumer_adapter else None,
+                             'consumer', external_bundle, out/'external-consumer-external-input', rec)
+                lanes['external_to_external'] = {'consumer': ee, 'comparison': compare(er, ee)}
+            record['external_lanes'] = lanes
+            if args.producer_adapter or args.consumer_adapter:
+                record['external_result'] = 'ADAPTER_ATTEMPT_RECORDED_UNASSESSED'
+            good = (local['transport_status'] == 'EVALUATED' and record['reference_expectation_met']
+                    and record['node_reference_parity']['agrees']
+                    and all(x['assertion_met'] for x in record['negative_controls']))
+            statuses = [ep['status'], ec['status']]
+            bad_adapter = any(s not in ('EXTERNAL_RESULT_NOT_SUPPLIED','BUNDLE_SUPPLIED','REPORTED') for s in statuses)
+            if ep['status'] == 'BUNDLE_SUPPLIED':
+                bad_adapter |= er['transport_status'] != 'EVALUATED' or ee['status'] not in ('EXTERNAL_RESULT_NOT_SUPPLIED','REPORTED')
+            record['status'] = 'LOCAL_CHECKS_COMPLETED' if good and not bad_adapter else 'FAILED'
+    except (Invalid, ValueError, KeyError, TypeError, OSError) as exc:
+        record['status'], record['error'] = 'FAILED', str(exc)
+    finally:
+        record['finished_at_utc'] = datetime.now(timezone.utc).isoformat()
+        record['evidence_files'] = inventory(out)
+        write(out/'run_record.json', record)
+        # Workdir remains available for inspecting/repeating exact captured commands.
+        write_results(out, record)
+    print(record['status'] + '; external: ' + record['external_result'])
+    return 1 if record['status'] == 'FAILED' else 0
+
+
+def write_results(out, record):
+    local = record.get('reference_to_reference', {})
+    summary = (local.get('reconcile', {}).get('result') or {}).get('summary')
+    lines = ['# K2 local same-version run', '', f"Target: `{TARGET['release']}` / `{TARGET['commit']}`.",
+             '', f"Harness: **{record['status']}**. External: **{record['external_result']}**.",
+             '', 'This is first-party local regression evidence. No third-party producer, consumer, authorship,',
+             'deployment interoperability or independent observation is established by this run.', '',
+             '## Reference producer → reference consumer', '',
+             f"Transport: `{local.get('transport_status','NOT_RUN')}`. Reconciliation: `{json.dumps(summary)}`.",
+             '', 'Exit zero means evaluation completed; FAILURE, MISSING and NOT_EVALUATED are retained.',
+             'The demo observer uses a test policy; it is not an external independent observer.', '',
+             '## Negative controls', '', '| Control | Assertion met |', '|---|---|']
+    lines += [f"| {c['name']} | {c['assertion_met']} |" for c in record.get('negative_controls', [])]
+    lines += ['', '## External lanes', '', 'See `run_record.json.external_lanes` for separately retained adapter responses and comparisons.',
+              'Absent adapters remain EXTERNAL_RESULT_NOT_SUPPLIED. Projection agreement is a comparison of reported',
+              'observations only; a supplied native result without a projection is NOT_COMPARABLE.', '',
+              '## Reproduction and limitations', '',
+              'Every argv, cwd, exit code and complete textual stdout/stderr is retained in run_record.json and logs/.',
+              'The binary Git archive is represented by its SHA-256 and exact reproduction command.',
+              'Source and dependency pinning is in pins.json. Linux x86-64 / CPython 3.12 wheels are used.',
+              'Adapters run as user-supplied local programs, not in a sandbox. A source-file hash does not attest',
+              'a complete implementation closure; contributor source, licence and toolchain evidence remains required.',
+              'This minimal transport does not support profiles, witnesses or remote deployments.',
+              'The release work directory is retained for inspection; it may be removed after review.']
+    if record.get('error'):
+        lines += ['', 'Error: ' + record['error']]
+    (out/'RESULTS.md').write_text('\n'.join(lines)+'\n')
+
+
+if __name__ == '__main__':
+    sys.exit(main())
