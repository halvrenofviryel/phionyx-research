diff --git a/interop/same-version/v0.2.0-beta.1/test_harness.py b/interop/same-version/v0.2.0-beta.1/test_harness.py
new file mode 100644
index 0000000000000000000000000000000000000000..60014ed76839dd650709c2bf39eef3c7256b1f06
--- /dev/null
+++ b/interop/same-version/v0.2.0-beta.1/test_harness.py
@@ -0,0 +1,295 @@
+"""Transport and failure-preservation tests; these adapters are local test doubles.
+
+Apache-2.0. They are never recorded as external interoperability evidence.
+"""
+from copy import deepcopy
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+import harness as h
+
+
+class HarnessTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.bundle = self.root/'input'
+        self.bundle.mkdir()
+        docs = [{'record_id': name, 'artifact_type': family, 'airep_version': '0.2'}
+                for name, family in [('d','decision'), ('s','control'), ('r','control'),
+                                     ('x','execution'), ('e','effect')]]
+        docs[1].update(boundary_side='issuer', control_event='dispatched')
+        docs[2].update(boundary_side='receiver', control_event='received')
+        h.write(self.bundle/'lifecycle.json', docs)
+        for name in h.REQUIRED[1:]:
+            h.write(self.bundle/name, {})
+        h.seal_bundle(self.bundle, 'local-test-fixture')
+        self.rec = h.Recorder(self.root/'record')
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def config(self, body, role='consumer', argv=None):
+        source = self.root/'adapter.py'
+        source.write_text(body)
+        config = self.root/'config.json'
+        h.write(config, {'role': role, 'target': h.TARGET, 'implementation_id': 'local-test-double',
+                        'argv': argv or [sys.executable, str(source)], 'source_file': str(source),
+                        'source_sha256': h.sha(source.read_bytes())})
+        return config
+
+    def invoke(self, body, role='consumer', argv=None):
+        return h.adapter(self.config(body, role, argv), role,
+                         self.bundle if role == 'consumer' else None,
+                         self.root/('output-'+str(len(self.rec.commands))), self.rec)
+
+    def actual_projection(self):
+        # Use a real release-pinned measurement, not a hand-built success shape.
+        source = h.HERE/'evidence/final-reference'
+        for name in (*h.REQUIRED, 'bundle.json'):
+            (self.bundle/name).write_bytes((source/'local-reference-bundle'/name).read_bytes())
+        return h.load((source/'run_record.json').read_bytes())['reference_to_reference']['observation']
+
+    def invoke_projection(self, observation):
+        script = ('import json,sys\nr=json.load(sys.stdin)\n'
+                  'response=dict(role="consumer",target=r["target"],implementation_id="local-test-double",'
+                  'input_manifest_sha256=r["input_manifest_sha256"],native_result={"local_test_double":True})\n'
+                  f'response["observation"]=json.loads({json.dumps(observation)!r})\n'
+                  'print(json.dumps(response))\n')
+        result = self.invoke(script)
+        self.assertEqual(self.rec.commands[-1]['exit_code'], 0)
+        return result
+
+    def assert_projection_rejected(self, observation):
+        result = self.invoke_projection(observation)
+        self.assertEqual(result['status'], 'ADAPTER_ERROR')
+        self.assertEqual(result['error'], 'MALFORMED_COMPARISON_PROJECTION')
+        self.assertNotIn('observation', result)
+        self.assertEqual(h.compare({'transport_status':'EVALUATED'}, result), 'ADAPTER_ERROR')
+
+    def test_no_submission_stays_missing(self):
+        r = h.adapter(None, 'consumer', self.bundle, self.root/'output', self.rec)
+        self.assertEqual(r['status'], 'EXTERNAL_RESULT_NOT_SUPPLIED')
+        self.assertEqual(self.rec.commands, [])
+
+    def test_adapter_unavailable_is_not_a_pass(self):
+        r = self.invoke('', argv=[str(self.root/'does-not-exist')])
+        self.assertEqual(r['status'], 'ADAPTER_UNAVAILABLE')
+        self.assertEqual(r['exit_code'], -1)
+
+    def test_nonzero_response_cannot_smuggle_success(self):
+        r = self.invoke('import json\nprint(json.dumps({"status":"PASS"}))\nraise SystemExit(9)\n')
+        self.assertEqual(r['status'], 'ADAPTER_PROCESS_ERROR')
+        self.assertEqual(r['exit_code'], 9)
+        self.assertNotIn('native_result', r)
+
+    def test_duplicate_json_keys_rejected(self):
+        with self.assertRaises(h.Invalid):
+            h.load('{"target": 1, "target": 2}')
+
+    def test_byte_change_rejected_even_same_json_value(self):
+        p = self.bundle/'lifecycle.json'
+        p.write_bytes(p.read_bytes()+b' ')
+        with self.assertRaisesRegex(h.Invalid, 'BYTE_HASH_MISMATCH'):
+            h.check_bundle(self.bundle)
+
+    def test_forged_hash_rejected(self):
+        m = h.load((self.bundle/'bundle.json').read_bytes())
+        m['files']['bindings.json'] = '0'*64
+        h.write(self.bundle/'bundle.json', m)
+        with self.assertRaisesRegex(h.Invalid, 'BYTE_HASH_MISMATCH'):
+            h.check_bundle(self.bundle)
+
+    def test_target_commit_mismatch_rejected(self):
+        m = h.load((self.bundle/'bundle.json').read_bytes())
+        m['target']['commit'] = '0'*40
+        h.write(self.bundle/'bundle.json', m)
+        with self.assertRaisesRegex(h.Invalid, 'TARGET_MISMATCH'):
+            h.check_bundle(self.bundle)
+
+    def test_wire_mismatch_rejected_after_rehash(self):
+        docs = h.load((self.bundle/'lifecycle.json').read_bytes())
+        docs[0]['airep_version'] = '0.1'
+        h.write(self.bundle/'lifecycle.json', docs)
+        h.seal_bundle(self.bundle, 'local-test-fixture')
+        with self.assertRaisesRegex(h.Invalid, 'WIRE_VERSION'):
+            h.check_bundle(self.bundle)
+
+    def test_issuer_cannot_supply_receiver_role(self):
+        docs = h.load((self.bundle/'lifecycle.json').read_bytes())
+        docs[2]['boundary_side'] = 'issuer'
+        h.write(self.bundle/'lifecycle.json', docs)
+        h.seal_bundle(self.bundle, 'local-test-fixture')
+        with self.assertRaisesRegex(h.Invalid, 'CONTROL_ROLE'):
+            h.check_bundle(self.bundle)
+
+    def test_adapter_role_cannot_change(self):
+        config = self.config('', role='producer')
+        r = h.adapter(config, 'consumer', self.bundle, self.root/'output', self.rec)
+        self.assertEqual(r['status'], 'ADAPTER_ERROR')
+        self.assertIn('ROLE_OR_TARGET', r['error'])
+        self.assertEqual(self.rec.commands, [])
+
+    def test_source_hash_mismatch_stops_execution(self):
+        config = self.config('raise RuntimeError("must not run")')
+        (self.root/'adapter.py').write_text('print(1)')
+        r = h.adapter(config, 'consumer', self.bundle, self.root/'output', self.rec)
+        self.assertIn('SOURCE_HASH_MISMATCH', r['error'])
+        self.assertEqual(self.rec.commands, [])
+
+    def test_input_mutation_detected(self):
+        r = self.invoke('import json,sys,pathlib\nr=json.load(sys.stdin)\np=pathlib.Path(r["input_bundle"])/"lifecycle.json"\np.write_bytes(p.read_bytes()+b" ")\nprint("{}")\n')
+        self.assertIn('INPUT_BYTES_CHANGED', r['error'])
+
+    def test_consumer_native_format_is_free(self):
+        r = self.invoke('import json,sys\nr=json.load(sys.stdin)\nprint(json.dumps(dict(role="consumer",target=r["target"],implementation_id="local-test-double",input_manifest_sha256=r["input_manifest_sha256"],native_result={"my_engine":"no-shared-verifier-code","answer":"unknown"})))\n')
+        self.assertEqual(r['status'], 'REPORTED')
+        self.assertIsNone(r['observation'])
+        self.assertEqual(h.compare({'transport_status':'EVALUATED'}, r), 'NOT_COMPARABLE')
+        self.assertEqual(r['independence'], 'NOT_ASSESSED')
+
+    def test_consumer_wrong_input_hash_rejected(self):
+        r = self.invoke('import json,sys\nr=json.load(sys.stdin)\nprint(json.dumps(dict(role="consumer",target=r["target"],implementation_id="local-test-double",input_manifest_sha256="0"*64,native_result={})))\n')
+        self.assertIn('INPUT_HASH_MISMATCH', r['error'])
+
+    def test_reference_process_errors_preserved(self):
+        # Empty cwd has no tools package: actual verifier AND reconciler processes fail.
+        empty = self.root/'empty'; empty.mkdir()
+        r = h.consume(empty, Path(sys.executable), self.bundle, self.root/'consumed', self.rec)
+        self.assertEqual(r['transport_status'], 'PROCESS_ERROR')
+        self.assertNotEqual(r['verify']['exit_code'], 0)
+        self.assertNotEqual(r['reconcile']['exit_code'], 0)
+        self.assertIsNone(r['observation'])
+
+    def test_projection_divergence_never_agrees(self):
+        observed = self.actual_projection()
+        ref = {'transport_status':'EVALUATED', 'observation': deepcopy(observed)}
+        observed['records'][0]['class'] = 'AIREP-Core'
+        ext = self.invoke_projection(observed)
+        self.assertEqual(ext['status'], 'REPORTED')
+        self.assertEqual(h.compare(ref, ext), 'PROJECTION_DIVERGES')
+        ref['transport_status'] = 'PROCESS_ERROR'
+        self.assertEqual(h.compare(ref, ext), 'REFERENCE_PROCESS_ERROR')
+
+    def test_producer_bundle_is_transport_only(self):
+        # The fixture omits normative required fields: transport accepts its shape,
+        # but this is never labelled authenticated or compatible.
+        script = ('import json,sys,pathlib,shutil\nr=json.load(sys.stdin)\n'
+                  f'shutil.copytree({str(self.bundle)!r}, pathlib.Path(r["output_dir"])/"bundle")\n'
+                  'p=pathlib.Path(r["output_dir"])/"bundle"/"bundle.json"\n'
+                  'm=json.loads(p.read_text()); m["implementation_id"]="local-test-double"\n'
+                  'p.write_text(json.dumps(m))\n'
+                  'print(json.dumps(dict(role="producer",target=r["target"],implementation_id="local-test-double")))\n')
+        result = self.invoke(script, role='producer')
+        self.assertEqual(result['status'], 'BUNDLE_SUPPLIED')
+        self.assertEqual(result['independence'], 'NOT_ASSESSED')
+        self.assertNotIn('class', result)
+
+    def test_nonobject_response_recorded_as_adapter_error(self):
+        r = self.invoke('print("[]")\n')
+        self.assertEqual(r['status'], 'ADAPTER_ERROR')
+        self.assertIn('RESPONSE_MUST_BE_OBJECT', r['error'])
+
+    def test_nonobject_manifest_rejected(self):
+        h.write(self.bundle/'bundle.json', [])
+        with self.assertRaisesRegex(h.Invalid, 'MANIFEST_MUST_BE_OBJECT'):
+            h.check_bundle(self.bundle)
+
+    def test_nonobject_artifact_rejected(self):
+        h.write(self.bundle/'lifecycle.json', [[],{},{},{},{}])
+        h.seal_bundle(self.bundle, 'local-test-fixture')
+        with self.assertRaisesRegex(h.Invalid, 'ARTIFACT_MUST_BE_OBJECT'):
+            h.check_bundle(self.bundle)
+
+    def test_actual_projection_accepted_through_adapter_subprocess(self):
+        observation = self.actual_projection()
+        result = self.invoke_projection(observation)
+        self.assertEqual(result['status'], 'REPORTED')
+        self.assertEqual(result['observation'], observation)
+        self.assertEqual(h.compare({'transport_status':'EVALUATED', 'observation':observation}, result), 'PROJECTION_AGREES')
+        self.assertEqual(result['independence'], 'NOT_ASSESSED')
+
+    def test_null_observation_remains_not_comparable(self):
+        result = self.invoke_projection(None)
+        self.assertEqual(result['status'], 'REPORTED')
+        self.assertEqual(h.compare({'transport_status':'EVALUATED'}, result), 'NOT_COMPARABLE')
+
+    def test_null_nested_projection_rejected(self):
+        self.assert_projection_rejected(dict(records=None, reconciliation_summary=None, checks=None))
+        for field in ('records', 'reconciliation_summary', 'checks'):
+            with self.subTest(field=field):
+                value = self.actual_projection(); value[field] = None
+                self.assert_projection_rejected(value)
+
+    def test_record_fields_and_vocabularies_rejected(self):
+        mutations = [
+            lambda r: r.pop('class'),
+            lambda r: r.update(record_id=None),
+            lambda r: r.update(record_id=''),
+            lambda r: r.update(record_id='\ud800'),
+            lambda r: r.update(**{'class':'PASS'}),
+            lambda r: r.update(observer_assessment='trusted'),
+            lambda r: r.update(authenticated_failures=None),
+            lambda r: r.update(authenticated_failures=[1]),
+            lambda r: r.update(authenticated_failures=['unknown-reason']),
+            lambda r: r.update(authenticated_withheld=['producer-signature-invalid']),
+            lambda r: r.update(witnessed_withheld=['no-witness-supplied','no-witness-supplied']),
+            lambda r: r.update(witnessed_withheld=['witness-binding-missing','no-witness-supplied']),
+            lambda r: r.update(authenticated_failures=['producer-signature-invalid']),
+            lambda r: r.update(**{'class':'AIREP-Witnessed'}),
+            lambda r: r.update(unregistered_field=True),
+        ]
+        for index, mutation in enumerate(mutations):
+            with self.subTest(mutation=index):
+                value=self.actual_projection(); mutation(value['records'][0])
+                self.assert_projection_rejected(value)
+
+    def test_record_container_and_identity_rejected(self):
+        for mutation in (lambda v:v.update(records={}), lambda v:v.update(records=[None]),
+                         lambda v:v['records'].append(deepcopy(v['records'][0])),
+                         lambda v:v['records'].reverse()):
+            value=self.actual_projection(); mutation(value)
+            self.assert_projection_rejected(value)
+
+    def test_summary_status_and_counts_rejected(self):
+        mutations = [lambda s:s.pop('status'), lambda s:s.update(status='PASS'),
+                     lambda s:s.update(status='SATISFIED'), lambda s:s.update(counts=None),
+                     lambda s:s['counts'].pop('MISSING'), lambda s:s['counts'].update(PASS=0)]
+        for count in (None, True, -1, 37.0, '37', 38):
+            mutations.append(lambda s,n=count:s['counts'].update(SATISFIED=n))
+        for index,mutation in enumerate(mutations):
+            with self.subTest(mutation=index):
+                value=self.actual_projection(); mutation(value['reconciliation_summary'])
+                self.assert_projection_rejected(value)
+
+    def test_check_fields_and_vocabularies_rejected(self):
+        mutations = [lambda c:c.pop('state'), lambda c:c.update(state='PASS'),
+                     lambda c:c.update(check='unregistered_check'), lambda c:c.update(subject=None),
+                     lambda c:c.update(subject='demo.decision'),
+                     lambda c:c.update(subject={'record_id':None,'chain_id':'demo.chain'}),
+                     lambda c:c.update(subject={'input_index':True}),
+                     lambda c:c.update(unregistered_field=1)]
+        for index,mutation in enumerate(mutations):
+            with self.subTest(mutation=index):
+                value=self.actual_projection(); mutation(value['checks'][0])
+                self.assert_projection_rejected(value)
+        for replacement in ({}, [None]):
+            value=self.actual_projection(); value['checks']=replacement
+            self.assert_projection_rejected(value)
+
+    def test_nested_check_identity_and_order_rejected(self):
+        value=self.actual_projection()
+        next(c for c in value['checks'] if c['check']=='issuer_dispatch')['subject']['decision_ref'] = None
+        self.assert_projection_rejected(value)
+        value=self.actual_projection()
+        next(c for c in value['checks'] if c['check']=='chain_link')['subject']['sequence'] = True
+        self.assert_projection_rejected(value)
+        value=self.actual_projection(); value['checks'].reverse()
+        self.assert_projection_rejected(value)
+
+
+if __name__ == '__main__':
+    unittest.main()
